{
    "name": "rafalswierczek/uuid",
    "description": "Super simple UUID generator in PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rafał Świerczek",
            "email": "swierczekraf@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-ffi": "*"
    },
    "autoload": {
        "psr-4": {
            "rafalswierczek\\Uuid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "rafalswierczek\\Uuid\\Test\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "ramsey/uuid": "^4.9",
        "symfony/console": "^7.",
        "symfony/uid": "^7.4",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
